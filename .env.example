# Copy to .env.local and fill in. Anything prefixed VITE_ is compiled into the
# JavaScript bundle and is therefore public — never put a password here.

# Base URL of the PHP content API (the /api folder, deployed).
#
# Leave it EMPTY and the site runs on the articles built into the bundle, with
# the studio saving to this browser only. That is the right setting until the
# database is up, and it is why nothing breaks in the meantime.
#
# Set it and /resources, the article pages and the studio all read and write
# MySQL instead.
#
#   VITE_API_URL=https://api.teask.asia
VITE_API_URL=
