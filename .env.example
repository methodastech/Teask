# Copy to .env.local and fill in. Anything prefixed VITE_ is compiled into the
# JavaScript bundle and is therefore public — never put a password here.

# Base URL of the PHP content API (the /api folder, deployed).
#
# Leave it EMPTY and the site runs on the articles built into the bundle, with
# the studio saving to this browser only. That is the right setting until the
# database is up, and it is why nothing breaks in the meantime.
#
# Set it and /resources, the article pages and the studio all read and write
# MySQL instead.
#
#   VITE_API_URL=https://api.teask.asia
VITE_API_URL=

# Where the contact form posts. Optional — an OVERRIDE, not a requirement.
#
# Leave it empty and nothing breaks:
#
#   production · posts to /api/contact.php, the PHP endpoint that ships with the
#                site (public/api/contact.php → dist/api/contact.php). Same
#                origin, so no CORS and no domain to configure. This is the
#                default and a normal GoDaddy deploy needs nothing here.
#   development · falls back to the visitor's own mail client, because the Vite
#                dev server cannot execute PHP.
#
# Set it only to point somewhere else — Formspree, a staging endpoint, a Node
# service. Anything accepting a JSON POST works.
#
#   VITE_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
VITE_CONTACT_ENDPOINT=
