# This folder holds files the studio uploaded. Treat everything in it as inert
# data: if an attacker ever gets a .php in here, it must not run.

Options -Indexes -ExecCGI

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phar .cgi .pl
  AddType text/plain .php .phtml .php3 .php4 .php5 .php6 .php7 .php8 .phar
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "\.(php|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
  </FilesMatch>
</IfModule>
