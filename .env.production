# Production build settings. Loaded by `npm run build` only — never by
# `npm run dev`, which is the point: the dev server cannot execute PHP, so
# pointing it at /api would break every local page load.
#
# COMMITTED ON PURPOSE. Nothing prefixed VITE_ is a secret — Vite compiles it
# into the JavaScript bundle, where anyone can read it. Keeping it untracked
# bought no safety and cost a live outage: the build deployed to teask.asia was
# made without it, so `apiEnabled` compiled to false, the site never called its
# own API, studio sign-in fell through to the hardcoded preview account and
# rejected every real password, and articles published through the CMS were
# invisible. A setting the site cannot work without does not belong in a file
# that exists on one laptop.

# Base URL of the PHP content API.
#
# Relative, not https://teask.asia/api: the API is served from /api on the same
# host, so a relative base is same-origin by construction — no CORS to
# configure, and it keeps working across www/non-www, http/https and any future
# domain. Netlify is unaffected; its value is set in the Netlify dashboard.
VITE_API_URL=/api

# Left empty deliberately — the contact form posts to /contact.php, which ships
# with the site. See .env.example.
VITE_CONTACT_ENDPOINT=
