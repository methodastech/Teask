# Ships with the built site (Vite copies public/ into dist/).
#
# React Router resolves /resources/<slug> in the browser, but Apache looks for
# a folder of that name first and returns 404. This hands every non-file
# request to index.html so the router can do its job — without it, opening an
# article link directly, or refreshing on one, breaks.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # anything that exists on disk is served as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Vite puts a content hash in every filename under /assets, so those can be
# cached forever — a new build produces new names. Files copied from public/
# keep their names between builds and must not be, or replacing an image would
# leave visitors on the old one.
<IfModule mod_headers.c>
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/" IMMUTABLE_ASSET=1
  </IfModule>
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE_ASSET
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
